# =============================================================================
# The Illusion Project - .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
.cursor/

# Jupyter Notebook
.ipynb_checkpoints/

# Logs and execution artifacts
*.log
*.tmp
*.temp
.cache/

# Models (too large for git)
results/models/
*.pkl
*.joblib

# OS files
.DS_Store
Thumbs.db
desktop.ini

# API keys and secrets
.env
*.env.local

# Archive folder (development artifacts)
.archive/

# External dependencies
Anthroscore-V2-main/
Chew-V2-main/

# =============================================================================
# DATA FILES
# =============================================================================

# Raw data (re-downloadable from Arctic Shift)
Data/raw/
Data/r_characterAI_comments.jsonl
*.jsonl

# Large intermediate files (can be regenerated)
Data/features/ultimate_predictor/
Data/features/*.backup*
Data/features/user_subreddit_interactions.parquet
Data/features/comments_with_anthroscores.parquet
Data/features/community_embeddings*.parquet
Data/features/demographics.parquet
Data/features/demographics_improved.parquet
Data/features/demographics_original_backup.parquet
Data/features/demographics_v2.parquet
Data/features/intent_topics.parquet
Data/features/full_analysis_data.parquet

# Old/superseded prediction files
experiments/v2_correction/age_predictions_v2.parquet
experiments/v2_correction/gender_predictions_v2.parquet
experiments/v2_correction/age_predictions_v5.parquet
experiments/v2_correction/gender_predictions_v5.parquet
experiments/v2_correction/all_features_v4.parquet

# Checkpoint files
*_checkpoint.parquet

# Subreddit-specific subsets (derivable from all_comments)
Data/processed/characterai_comments.parquet
Data/processed/replika_comments.parquet
Data/processed/aicompanions_comments.parquet
Data/processed/*.jsonl

# =============================================================================
# ESSENTIAL FILES - DO NOT IGNORE (tracked via Git LFS)
# =============================================================================
# These files are required for reproducibility:
#
# Core data:
#   Data/processed/all_comments.parquet (~31 MB)
#
# AnthroScore V3:
#   experiments/anthroscore_v3/anthroscore_v3_improved_final.parquet (~14 MB)
#   experiments/anthroscore_v3/anthroscore_v3_full.parquet (~23 MB)
#   experiments/anthroscore_v3/test_set_expert_labeled.parquet
#
# Demographics V4 (produces paper statistics):
#   experiments/v2_correction/age_predictions_v4.parquet
#   experiments/v2_correction/gender_predictions_v4.parquet
#
# Demographics V3 (reference):
#   experiments/v2_correction/age_predictions_v3.parquet
#   experiments/v2_correction/gender_predictions_v3.parquet
#
# Features:
#   Data/features/user_emotions.parquet
#   Data/features/user_anthroscores.parquet
#   Data/features/self_declarations.parquet
#   Data/features/llm_classifications.parquet
#   Data/features/full_merged_dataset.parquet
#   Data/features/comments_with_emotions.parquet
#
# Human validation:
#   experiments/anthroscore_v3/HUMAN_VALIDATION_BLIND.xlsx
#   experiments/anthroscore_v3/HUMAN_VALIDATION_ANSWER_KEY.xlsx
#   Validations/*.csv
#
# Publication figures:
#   results/paper_figures/*.pdf
#   results/paper_figures/*.png
